{
  "name": "commit-exe",
  "displayName": "Commit.exe",
  "description": "A fast and simple Git commit and push workflow for VS Code.",
  "version": "0.0.1",
  "publisher": "unaidevel",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:commit-exe.commit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commit-exe.commit",
        "title": "Commit.exe: Commit"
      }
    ],
    "keybindings": [
      {
        "command": "commit-exe.commit",
        "key": "ctrl+alt+c"
      }
    ],
    "configuration": {
      "title": "Commit.exe",
      "properties": {
        "commit-exe.autoPush": {
          "type": "boolean",
          "default": true,
          "description": "Automatically push after a successful commit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  }
}